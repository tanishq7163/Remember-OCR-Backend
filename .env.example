# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── File Storage ──────────────────────────────────
UPLOAD_DIR="./uploads"
TEMP_DIR="./tmp"
MAX_FILE_SIZE_MB=50

# ── OCR Provider ──────────────────────────────────
# Options: google_vision | azure_vision | aws_textract
OCR_PROVIDER=google_vision

# ── Google Cloud Vision ───────────────────────────
# Path to service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="./credentials/google-vision-key.json"
GOOGLE_CLOUD_PROJECT_ID="remember-775873"

# ── Azure AI Vision (optional) ────────────────────
AZURE_VISION_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_VISION_KEY="your-azure-vision-key"

# ── AWS Textract (optional) ───────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# ── Auth ──────────────────────────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="NhE5QhhFvvsA5DTMCOvJVoF7uawXt43xHZMZSXcgXNjKCnP6FvWOXQCTSQszOoM4WMjcEgkNzr+wzcoQxALg0A=="

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── OCR Retry ────────────────────────────────────
OCR_MAX_RETRIES=3
OCR_RETRY_DELAY_MS=2000
OCR_TIMEOUT_MS=60000
